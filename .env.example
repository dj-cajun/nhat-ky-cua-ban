# ─── 데모 모드 ───
# true: 온보딩 생략, 호치민 Marie Curie 11A 자동 시작
# false: 학교·학급 온보딩 표시
VITE_DEMO_MODE=true

# ─── Supabase (배포 시 교체) ───
# 인스턴스가 없으면 false — 로컬 전용 모드 (401 방지)
VITE_SUPABASE_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Zalo Mini App (배포 시 교체) ───
VITE_ZMP_APP_ID=

# ─── 힌트 SHA-256 pepper (프로덕션 필수, 서버 HMAC 권장) ───
VITE_HINT_PEPPER=
